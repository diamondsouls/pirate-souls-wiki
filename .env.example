# Copy this file to `.env` and fill in real values.
# Note: Docusaurus does not load `.env` automatically. See README "Local
# development" for how to wire it up (dotenv-cli or `require('dotenv')`).

# URL of the edit-service that backs "Edit this page" links.
# - Local dev: http://localhost:8000 (default if unset)
# - Production: the public URL of the deployed edit-service
EDIT_SERVICE_URL=http://localhost:8000

# EDIT_SERVICE_SECRET is NOT used locally. It lives in GitHub Actions
# secrets (repo Settings -> Secrets and variables -> Actions) and is read
# by .github/workflows/notify-merge.yml. Do not put it here.
